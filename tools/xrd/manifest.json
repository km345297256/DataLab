{"plugin":"xrd","version":"1.0.0","handler":"handler.py","tools":[
{"name":"xrdml_inspect","description":"解析 XRDML 文件元数据、扫描数量和测量点数。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"xrdml_validate","description":"检查 XRDML 扫描轴、强度数组、数值有效性和数据完整性。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_list_scans","description":"列出 XRDML 内所有扫描的范围、点数和扫描属性。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"xrdml_extract_scan","description":"提取指定扫描的角度和强度数据。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"scan_index":{"type":"integer","minimum":0,"default":0},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_export_csv","description":"将 XRDML 扫描数据导出为 CSV。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"scan_index":{"type":"integer","minimum":0,"default":0},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"xrdml_merge_scans","description":"合并多个兼容扫描为统一角度网格的数据产品。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_resample","description":"将衍射扫描重采样到指定角度步长。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"step":{"type":"number","minimum":0.0001,"default":0.02},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_background_subtract","description":"估计并扣除衍射谱背景，保留处理方法和结果。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_smooth","description":"使用 Savitzky-Golay 方法平滑衍射曲线。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"window":{"type":"integer","minimum":5,"default":11},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_zero_shift_correct","description":"按用户提供的零点偏移量校正 2θ 角度。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"shift":{"type":"number"},"output_path":{"type":["string","null"]}},"required":["input_path","shift"]}},
{"name":"xrdml_wavelength_convert","description":"依据已声明波长在 2θ 与晶面间距之间进行波长转换。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"wavelength":{"type":"number","default":1.5406},"target_wavelength":{"type":"number"},"output_path":{"type":["string","null"]}},"required":["input_path","target_wavelength"]}},
{"name":"xrdml_peak_detect","description":"检测衍射峰位置、强度和半峰宽候选。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"prominence":{"type":"number","default":0},"min_distance":{"type":"integer","minimum":1,"default":3},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_peak_fit","description":"返回衍射峰拟合候选，提示峰窗口和模型参数限制。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_crystallite_size","description":"根据峰宽和用户提供的仪器展宽参数估算晶粒尺寸，并标注近似性。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_microstrain","description":"提供微应变分析所需峰候选和结构化输出入口。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
{"name":"xrdml_visualize","description":"生成 XRDML 衍射曲线 PNG 图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"xrdml_compare_patterns","description":"生成指定衍射曲线的对比图并保留样品文件名。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
{"name":"xrdml_export_report","description":"输出 XRDML 扫描元数据、强度统计和峰候选报告。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}}
]}
