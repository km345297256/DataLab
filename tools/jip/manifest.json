{"name":"jip_baseline_correct","description":"对可识别数值序列进行基线校正并输出处理结果。","scopes":["dataset_fast_path"],"timeout_seconds":90,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
