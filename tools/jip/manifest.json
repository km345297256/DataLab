{"plugin":"jip","version":"1.0.0","handler":"handler.py","tools":[
{"name":"jip_identify_format","description":"识别 JIP 文件是文本、分隔文本、XML、JSON 或未知二进制格式，并给出依据。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
{"name":"jip_inspect","description":"探查 JIP 文件结构、元数据摘要、行列数量和格式信息。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"}},"required":["input_path"]}},
