{"name":"jip_visualize","description":"生成 JIP 数值序列的 PNG 预览图。","scopes":["dataset_fast_path"],"timeout_seconds":120,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":"string"}},"required":["input_path","output_path"]}},
