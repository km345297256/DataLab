{"name":"jip_extract_metadata","description":"提取 JIP 样品、仪器和文件元数据，保留原始字段证据。","scopes":["dataset_fast_path"],"timeout_seconds":60,"parameters":{"type":"object","properties":{"input_path":{"type":"string"},"output_path":{"type":["string","null"]}},"required":["input_path"]}},
